<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Instancium.Publisher</AssemblyName>
    <RootNamespace>Instancium.Publisher.Tui</RootNamespace>
    <Version>1.8.0-rc.1</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Instancium.Publisher.Application\Instancium.Publisher.Application.csproj" />
    <ProjectReference Include="..\Instancium.Publisher.Domain\Instancium.Publisher.Domain.csproj" />
    <ProjectReference Include="..\Instancium.Publisher.Infrastructure\Instancium.Publisher.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>